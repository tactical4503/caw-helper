; Engine configuration file.
; Godot 4.x project. Open this folder from the Godot project manager (Import).

config_version=5

[application]

config/name="AFTERBELL — Closing Time"
config/description="Chapter One of AFTERBELL: Bellwether's Department Store, from Cosmetics to the Floor Manager's court."
run/main_scene="res://rooms/title.tscn"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/LiberationSerif-Regular.ttf"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2

[importer_defaults]

texture={
"mipmaps/generate": true
}
